# Supabase（v0.14.x — 雲端 auth + DB）
# 沒設定時自動 fallback 到 localStorage

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ErrorTracker endpoint（v0.13.x — 錯誤追蹤 scaffold）
# 留空 → 只 console.error（dev 模式）
# 填入實際 endpoint → 透過 navigator.sendBeacon 送到伺服器
NEXT_PUBLIC_ERROR_ENDPOINT=

# Web Vitals endpoint（同上）
NEXT_PUBLIC_VITALS_ENDPOINT=

# Sentry error tracking（v0.26.0b+）
# 留空 → ErrorTracker 只 console.error，server / client 都不送 Sentry
# 填入 DSN → 自動 init via sentry.{client,server}.config.ts
# 參考：AGENTS.md §32 ErrorTracker → Sentry 整合

# Server-side errors（API routes / server components 拋出的錯誤）
SENTRY_DSN=
# Client-side errors（瀏覽器 JS 錯誤 + app/error.tsx Error Boundary 捕獲）
NEXT_PUBLIC_SENTRY_DSN=
# 選填：source map upload（只在 CI / production build 需要）
# 到 https://sentry.io/orgredirect/organizations/:orgslug/settings/auth-tokens/ 開 token
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
