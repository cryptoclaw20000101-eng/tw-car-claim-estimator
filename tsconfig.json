{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    // v0.12.0+ Phase D1：TypeScript strict 加嚴（保守版）
    // - noUncheckedIndexedAccess：會炸 122 個 array[i] 存取（lib/ + tests/），留待 v0.13.x 修補
    // - exactOptionalPropertyTypes：會炸 AntD 元件 prop 類型定義
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    // v0.18.0：D1 strict noUncheckedIndexedAccess 啟用
    // - 所有 array[i] 存取現在回傳 T | undefined（之前是 T）
    // - 修法：加 ! 斷言（確定有值）或 null check（防呆）
    // - scope: scripts/ (62) + lib/ (38) + tests/ (47) + app/ (20) ≈ 167 sites
    // - 113 errors 跨 19 檔案（v0.18.0+ 啟用，預計分批修）
    // - 目前先不啟用（AGENTS §2 鐵律 pnpm add 需授權 + 風險控管），留 v0.19.x 拆批修
    // "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
