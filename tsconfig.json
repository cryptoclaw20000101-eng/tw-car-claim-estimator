{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    // v0.12.0+ Phase D1：TypeScript strict 加嚴（保守版）
    // - noUncheckedIndexedAccess：會炸 122 個 array[i] 存取（lib/ + tests/），留待 v0.13.x 修補
    // - exactOptionalPropertyTypes：會炸 AntD 元件 prop 類型定義
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    // v0.15.x：D1 完整 TS strict 第 2 批 — 開啟 noUncheckedIndexedAccess
    // 目前 scripts/ 有 pre-existing array[i] 存取（其他 agent 改的檔），
    // 修這些會動到他們的 code → 留 v0.15.x 拆檔後再處理。
    // 開啟方式：把下面那行 uncomment + 修 scripts/ + __tests__/ + lib/ 全部 array[i]
    // "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
