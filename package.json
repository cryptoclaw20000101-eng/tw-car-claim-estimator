{
  "name": "tw-car-claim-estimator",
  "version": "0.12.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "prepare": "husky",
    "scrape:build": "tsc -p scripts/tsconfig.json",
    "scrape:dry": "node scripts/scrape-judgments.js --dry-run",
    "scrape": "node scripts/scrape-judgments.js",
    "scrape:cron": "node scripts/scrape-judgments.js --quiet",
    "scrape:cron-dry": "node scripts/scrape-judgments.js --dry-run --quiet",
    "report:build": "tsc -p scripts/tsconfig.json",
    "report:precedents": "node scripts/report-precedents.js",
    "report:rebuild-hero": "bash scripts/rebuild-hero.sh",
    "report:all": "node scripts/scrape-judgments.js --quiet && node scripts/report-precedents.js",
    "analyze": "ANALYZE=true pnpm build",
    "law-cutoff:build": "tsc -p scripts/law-cutoff.tsconfig.json",
    "perf:audit": "tsx scripts/perf-audit.ts",
    "law-cutoff": "node .law-cutoff-build/scripts/law-cutoff.js",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:info": "tauri info",
    "deploy:vercel": "vercel --prod --yes",
    "deploy:preview": "vercel --yes"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.5",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@supabase/supabase-js": "^2.110.0",
    "antd": "^6.4.3",
    "dayjs": "^1.11.21",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "web-vitals": "^5.3.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "overrides": {
      "postcss@<8.5.10": ">=8.5.10",
      "undici@<7.28.0": "7.28.0"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "19",
        "react-dom": "19"
      }
    }
  },
  "devDependencies": {
    "@axe-core/react": "^4.12.1",
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@next/bundle-analyzer": "^16.2.10",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^4.1.8",
    "vitest-axe": "^0.1.0"
  }
}
