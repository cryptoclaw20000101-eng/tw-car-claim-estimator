# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp

# scripts build artifacts (tsc → .js in-place)
# tsc 編出檔（scripts/tsconfig.json 編 .ts → .js，固定這幾個）
/scripts/scrape-judgments.js
/scripts/scrape-judgments.d.ts
/scripts/report-precedents.js
/scripts/report-precedents.d.ts
# build-insurance-constants.js 是失敗的 regex 工具，不 commit
/scripts/build-insurance-constants.js
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
public/embedded-precedents.json  # v0.3.1 build script 中繼產物（HTML 內嵌精簡版 52KB）
