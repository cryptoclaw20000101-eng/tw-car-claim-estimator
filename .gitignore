# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp

# scripts build artifacts (tsc → .js in-place)
# tsc 編出檔（scripts/tsconfig.json 編 .ts → .js，固定這幾個）
/scripts/scrape-judgments.js
/scripts/scrape-judgments.d.ts
/scripts/report-precedents.js
/scripts/report-precedents.d.ts
# build-insurance-constants.js 是失敗的 regex 工具，不 commit
/scripts/build-insurance-constants.js
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright
/test-results/
/playwright-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/public/embedded-precedents.json
/public/embedded-precedents.js

# Tauri v0.4.0 build artifacts
/src-tauri/target/
/src-tauri/gen/
/src-tauri/Cargo.lock
/src-tauri/WixTools/

# Tauri icon 生成中繼（從 public/icons/icon-512.png 生成，已 commit 到 src-tauri/icons/）
/src-tauri/icons/android/
/src-tauri/icons/ios/

# v0.8.4+ law-cutoff CLI 編譯產物（pnpm law-cutoff:build 產生）
/.law-cutoff-build/

# v0.18.0+ tsc bleed-over 路徑防護
# scripts/tsconfig.json 跑 tsc -p 從 project root 時會 emit 到 scripts/scripts/ + scripts/lib/
# （因為 import 路徑 ../lib/... 被 mirror 到 outDir 下）
# 加這兩條避免未來 rebuild 時新產物被誤 add，但既有 tracked 檔不受影響
/scripts/scripts/
/scripts/lib/
